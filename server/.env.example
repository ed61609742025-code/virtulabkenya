# VirtuLab Kenya — Environment Variables Template
PORT=3000
DATABASE_URL=postgresql://user:password@hostname:5432/virtulabkenya
JWT_SECRET=your_production_jwt_secret_key_here
JWT_EXPIRES_IN=7d
NODE_ENV=production
ADMIN_EMAIL=admin@virtulab.co.ke
ADMIN_PASSWORD=your_secure_admin_password_here
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite

# SMTP Email Configuration (Google Workspace / Zoho / cPanel)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=admin@virtulab.co.ke
SMTP_PASS=your_app_specific_password_here
EMAIL_FROM="VirtuLab Kenya <admin@virtulab.co.ke>"
PLATFORM_URL=https://virtulab.co.ke

